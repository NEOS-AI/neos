# 데이터베이스 설정
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/neos
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis 설정
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600
WORKFLOW_RESPONSE_CACHE_TTL=86400  # 24 hours

# AI 서비스 API 키
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# LLM 설정
LLM_PROVIDER=openai  # "openai" or "anthropic"
LLM_MODEL=gpt-5  # or "claude-sonnet-4-5-20250929"
LLM_TEMPERATURE=0.1

# 임베딩 설정
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Vision 모델 설정
VISION_PROVIDER=auto  # "gpt4o", "claude", "auto" (auto는 LLM_PROVIDER 기반 자동 선택)
VISION_ENABLED=true  # Vision 모델 사용 여부
VISION_MAX_TOKENS=1000  # Vision 응답 최대 토큰
VISION_IMAGE_DETAIL=auto  # GPT-4o 이미지 상세도: "auto", "low", "high"

# 에이전트 설정
MAX_ITERATIONS=10
AGENT_TIMEOUT=300

# API 설정
API_V1_PREFIX=/api/v1
DEBUG=true

# 로그 설정
LOG_LEVEL=INFO

# 데이터셋 수집 설정
DATASET_AUTO_SAVE=true  # 워크플로우 실행 후 자동 저장
DATASET_SAVE_FORMAT=jsonl  # jsonl, json, csv
DATASET_BASE_PATH=datasets  # 데이터셋 저장 경로

# 웹 검색 로깅 설정
WEB_SEARCH_LOG_ASYNC=true  # 비동기 로깅 활성화
WEB_SEARCH_LOG_QUEUE_TYPE=memory  # 메시지 큐 타입: "memory", "redis", "kafka"
# WEB_SEARCH_LOG_QUEUE_TYPE=redis  # Redis 사용 시 주석 해제 및 REDIS_URL 설정 필요
