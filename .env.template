CHECKPOINTER_S3_ENDPOINT_URL=http://localhost:9000
CHECKPOINTER_S3_ACCESS_KEY=your-access-key
CHECKPOINTER_S3_SECRET_KEY=your-secret-key

# ============================================================================
# ROMA: RECURSIVE OPEN META-AGENT (NEOS v0.22.0+)
# ============================================================================
# 주의: 기본값 false - 활성화 시 LLM 호출 횟수 및 비용 증가

# 재귀 에이전트 활성화 여부 (기본값: false - 기존 워크플로우 완전 보존)
RECURSIVE_AGENT_ENABLED=false

# 최대 재귀 깊이 (기본값: 3 / 권장 범위: 2-5)
RECURSIVE_MAX_DEPTH=3

# 레벨당 최대 하위 태스크 수 (기본값: 4 / 깊이 증가 시 자동 감소)
RECURSIVE_MAX_TASKS_PER_LEVEL=4

# 재귀 에이전트 활성화 복잡도 임계값 (기본값: 0.8 / 0.0-1.0)
# query_classification.complexity_score >= 이 값이면 재귀 경로로 라우팅
RECURSIVE_COMPLEXITY_THRESHOLD=0.8

# Atomizer LLM 모델 (비용 최소화, Haiku 권장)
RECURSIVE_ATOMIZER_MODEL=claude-haiku-4-5-20251001

# Planner LLM 모델 (상위 레벨 분해, Opus 권장)
RECURSIVE_PLANNER_MODEL=claude-opus-4-6

# 재귀 실행 비용 한도 (USD, 기본값: 0.5)
RECURSIVE_BUDGET_CAP=0.5

# ============================================================================
# HYPER DEEP RECURSIVE AGENT (ROMA + HyperDeepResearchAgent 통합)
# 구조적 재귀 분해(ROMA) + 심층 리서치(HyperDeepResearch) 결합
# 주의: RECURSIVE_AGENT_ENABLED와 독립적으로 활성화 가능
# ============================================================================

# HyperDeep 재귀 에이전트 활성화 여부 (기본값: false)
HYPER_DEEP_AGENT_ENABLED=false

# 최대 재귀 깊이 (기본값: 1 — leaf가 무겁기 때문에 얕은 분해 권장)
HYPER_DEEP_MAX_DEPTH=1

# 레벨당 최대 하위 태스크 수 (기본값: 3)
HYPER_DEEP_MAX_TASKS_PER_LEVEL=3

# HyperDeep 활성화 복잡도 임계값 (기본값: 0.85 — ROMA 0.80보다 높은 기준)
HYPER_DEEP_COMPLEXITY_THRESHOLD=0.85

# HyperDeep 실행 비용 한도 (USD, 기본값: 5.0 — ROMA 0.5의 10배)
HYPER_DEEP_BUDGET_CAP=5.0

# ============================================================================
# RAY 분산 처리 (Phase 1+)
# 독립 sibling subtask를 별도 프로세스에서 병렬 실행 (최대 2.7× 속도 향상)
# max_tasks_per_level=3 기준: 순차 ~6.25분 → 병렬 ~2.3분
# ============================================================================

# Ray 분산 처리 활성화 여부 (기본값: false — 순차 실행 유지)
# RAY_ENABLED=false

# Ray 클러스터 주소
# 단일 노드: "auto" (로컬 Ray 클러스터 자동 시작)
# 외부 클러스터: "ray://head-node:10001"
# RAY_ADDRESS=auto

# Ray Object Store 메모리 (bytes, 기본값: 2GB)
# pool_size=3 기준 Worker당 ~512MB × 3 = 1.5GB 사용 예상
# RAY_OBJECT_STORE_MEMORY=2000000000

# ============================================================================
# CONTEXTUAL RETRIEVAL (Anthropic Contextual Retrieval 기법)
# ============================================================================
# 활성화 시 문서 청크마다 전체 문서 컨텍스트를 반영한 설명문을 자동 생성
# → 검색 실패율 35% 감소 (Anthropic 실험 기준, BM25+Reranking 적용 시 67%+)
# 주의: ANTHROPIC_API_KEY 필수, 문서당 약 $0.001~0.10 추가 비용 발생

# Contextual Retrieval 활성화 여부 (기본값: false)
CONTEXTUAL_RETRIEVAL_ENABLED=false

# 컨텍스트 생성 모델 (Haiku 권장 - 비용 효율)
CONTEXTUAL_MODEL=claude-haiku-4-5-20251001

# 생성할 컨텍스트 최대 토큰 수 (1-2문장 = 80-150 토큰으로 충분)
CONTEXTUAL_MAX_TOKENS=200

# 동시 처리 청크 수 (속도 vs. Rate Limit 균형, 기본값: 3)
CONTEXTUAL_MAX_CONCURRENT=3

# 문서당 최대 처리 청크 수 (비용 통제용, 초과 시 앞쪽 N개만 처리)
CONTEXTUAL_MAX_CHUNKS_PER_DOC=200

# 문서당 비용 상한선 (USD, 초과 시 원본 텍스트로 graceful degradation)
CONTEXTUAL_BUDGET_CAP_USD=0.10

# 임베딩 소스: "contextual" = contextual_text, "original" = chunk_text
CONTEXTUAL_EMBED_SOURCE=contextual

# ============================================================================
# MESSAGE QUEUE (REDIS/CELERY)
# ============================================================================

CELERY_ENABLED=true

# Celery broker URL
CELERY_BROKER_URL=redis://localhost:6379/2

# Celery result backend
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================================================
# MONITORING (PROMETHEUS/GRAFANA)
# ============================================================================

