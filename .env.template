# 데이터베이스 설정
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/neos
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis 설정
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600
WORKFLOW_RESPONSE_CACHE_TTL=86400  # 24 hours

# AI 서비스 API 키
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# LLM 설정
LLM_PROVIDER=openai  # "openai" or "anthropic"
LLM_MODEL=gpt-4-turbo-preview  # or "claude-sonnet-4-20250514"
LLM_TEMPERATURE=0.1

# 임베딩 설정
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# 에이전트 설정
MAX_ITERATIONS=10
AGENT_TIMEOUT=300

# API 설정
API_V1_PREFIX=/api/v1
DEBUG=true

# 로그 설정
LOG_LEVEL=INFO

# 데이터셋 수집 설정
DATASET_AUTO_SAVE=true  # 워크플로우 실행 후 자동 저장
DATASET_SAVE_FORMAT=jsonl  # jsonl, json, csv
DATASET_BASE_PATH=datasets  # 데이터셋 저장 경로
