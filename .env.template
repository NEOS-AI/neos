# NEOS Environment Template
#
# Copy this file to `.env` and fill in secret values only. Do not commit `.env`.
# Put non-secret runtime settings in YAML instead:
#
#   cp config/neos.example.yaml config/neos.local.yaml
#   NEOS_CONFIG_PATH=config/neos.local.yaml
#
# See docs/CONFIGURATION.md for the full configuration workflow.

# ============================================================================
# CONFIG PROFILE CONTROLS
# ============================================================================

NEOS_ENV=development
NEOS_CONFIG_PATH=config/neos.local.yaml
NEOS_SECRETS_PATH=
NEOS_MODEL_CONFIG_PATH=

# ============================================================================
# DATABASE, REDIS, AND CELERY SECRET-BEARING URLS
# ============================================================================

DATABASE_URL=postgresql+asyncpg://neos_user:CHANGE_THIS_PASSWORD@localhost:5432/neos_db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================================================
# AUTH AND OAUTH SECRETS
# ============================================================================

JWT_SECRET_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Web-only secrets when Compose or the web app reads the root `.env`.
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AI_GATEWAY_API_KEY=

# ============================================================================
# MANAGED SANDBOX CONTROL PLANE SECRETS
# ============================================================================

# base64-encoded 16/24/32-byte AES-GCM key. Required only when
# sandbox.managed.enabled=true (see docs/CONFIGURATION.md).
MANAGED_PROVIDER_REFERENCE_KEY=

# ============================================================================
# AI PROVIDER KEYS
# ============================================================================

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# The coding model reuses ANTHROPIC_API_KEY; configure its non-secret policy in YAML.
GOOGLE_API_KEY=
COHERE_API_KEY=

# ============================================================================
# SEARCH, SOURCE, AND DATA API KEYS
# ============================================================================

TAVILY_API_KEY=
YOUTUBE_API_KEY=
GITHUB_API_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
SERPAPI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
NEWS_API_KEY=
OPENWEATHER_API_KEY=
EXCHANGERATE_API_KEY=
FINANCIALDATASETS_API_KEY=
ALPHA_VANTAGE_API_KEY=

# ============================================================================
# STORAGE CREDENTIALS
# ============================================================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
CHECKPOINTER_S3_ACCESS_KEY=
CHECKPOINTER_S3_SECRET_KEY=

# ============================================================================
# CHANNEL ADAPTER TOKENS
# ============================================================================

CHANNEL_TELEGRAM_BOT_TOKEN=
CHANNEL_DISCORD_BOT_TOKEN=
CHANNEL_SLACK_BOT_TOKEN=
CHANNEL_SLACK_APP_TOKEN=

# ============================================================================
# COMPOSE-ONLY INFRASTRUCTURE SECRETS
# ============================================================================

POSTGRES_PASSWORD=
GRAFANA_PASSWORD=
