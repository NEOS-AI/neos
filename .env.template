# NEOS Environment Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL connection URL
# Format: postgresql+asyncpg://username:password@host:port/database
DATABASE_URL=postgresql+asyncpg://neos_user:CHANGE_THIS_PASSWORD@localhost:5432/neos_db

# Database connection pool settings
# 연결 풀 최적화: 총 50개 (20+30) 연결로 DB 부하 방지
# PostgreSQL max_connections를 확인하고 조정하세요 (기본값: 100)
DATABASE_POOL_SIZE=20  # 기본 연결 풀 크기
DATABASE_MAX_OVERFLOW=30  # 추가 가능한 최대 연결 수
DATABASE_POOL_TIMEOUT=30  # 연결 대기 타임아웃 (초)
DATABASE_POOL_RECYCLE=1800  # 연결 재사용 시간 (초, 30분)

# ============================================================================
# REDIS CACHE CONFIGURATION
# ============================================================================

# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# Default cache TTL in seconds (default: 3600 = 1 hour)
REDIS_TTL=3600

# Redis connection pool settings (신규 추가)
REDIS_POOL_SIZE=50  # 최대 연결 수
REDIS_MIN_IDLE_CONNECTIONS=10  # 최소 유휴 연결 수

# Workflow response cache TTL (개선됨: 24시간 → 2시간)
WORKFLOW_RESPONSE_CACHE_TTL=7200

# Semantic caching configuration
# 유사한 쿼리의 응답을 재사용하여 LLM 호출 비용과 응답 시간을 절감
SEMANTIC_CACHE_ENABLED=true  # 개선: 기본값 활성화
SEMANTIC_CACHE_THRESHOLD=0.90  # 개선: 유사도 임계값 낮춤 (0.95 → 0.90, 더 많은 캐시 히트)

# ============================================================================
# AI SERVICE API KEYS (REQUIRED)
# ============================================================================

# OpenAI API Key (required for embeddings and GPT models)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_API_KEY

# Anthropic API Key (required for Claude models)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_ANTHROPIC_API_KEY

# Tavily Search API Key (required for web search)
# Get from: https://tavily.com/
TAVILY_API_KEY=tvly-REPLACE_WITH_YOUR_TAVILY_API_KEY

# ============================================================================
# EXTERNAL API KEYS (OPTIONAL)
# ============================================================================

# Weather API (OpenWeatherMap)
# Get from: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Currency Exchange API
# Get from: https://www.exchangerate-api.com/
EXCHANGERATE_API_KEY=

# Stock Market APIs
STOCK_API_PROVIDER=yahoo
FINANCIALDATASETS_API_KEY=
ALPHA_VANTAGE_API_KEY=

# ============================================================================
# LLM CONFIGURATION
# ============================================================================

# LLM Provider: "openai" or "anthropic"
LLM_PROVIDER=anthropic

# LLM Model name
# OpenAI: gpt-4-turbo-preview, gpt-4, gpt-3.5-turbo
# Anthropic: claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307
LLM_MODEL=claude-3-sonnet-20240229

# LLM Temperature (0.0 = deterministic, 2.0 = creative)
LLM_TEMPERATURE=0.1

# ============================================================================
# EMBEDDING CONFIGURATION
# ============================================================================

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small

# Embedding dimension (must match model)
# text-embedding-3-small: 1536
# text-embedding-3-large: 3072
EMBEDDING_DIMENSION=1536

# ============================================================================
# VISION MODEL CONFIGURATION
# ============================================================================

# Vision provider: "gpt4o", "claude", "auto"
VISION_PROVIDER=auto

# Enable/disable vision features
VISION_ENABLED=true

# Vision model max tokens
VISION_MAX_TOKENS=1000

# GPT-4o image detail level: "auto", "low", "high"
VISION_IMAGE_DETAIL=auto

# ============================================================================
# AGENT CONFIGURATION
# ============================================================================

# Maximum agent iterations
MAX_ITERATIONS=10

# Agent timeout in seconds
AGENT_TIMEOUT=300

# Agent concurrency settings (신규 추가)
MAX_CONCURRENT_WORKFLOWS=100  # 최대 동시 워크플로우 수
MAX_CONCURRENT_AGENTS_PER_WORKFLOW=10  # 워크플로우당 최대 동시 에이전트 수

# Circuit Breaker Configuration (신규 추가 - 고성능 멀티 에이전트 시스템)
CIRCUIT_BREAKER_ENABLED=true  # Circuit Breaker 활성화
CIRCUIT_BREAKER_FAIL_THRESHOLD=5  # 연속 실패 횟수 (이 횟수만큼 실패하면 차단)
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60  # 복구 시도 간격 (초)

# ============================================================================
# AUTHENTICATION & SECURITY (CRITICAL - MUST CHANGE IN PRODUCTION!)
# ============================================================================

# JWT Secret Key - **REQUIRED** - Application will not start without this!
# Generate a secure key with one of these commands:
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Example output: 7f8a9b2c5d1e4f6a8b3c9d2e1f4a6b8c9d2e1f4a6b8c9d2e1f4a6b8c9d2e
JWT_SECRET_KEY=

# JWT algorithm
JWT_ALGORITHM=HS256

# Access token expiration (minutes)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token expiration (days)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# API GATEWAY CONFIGURATION
# ============================================================================

# Enable API Gateway mode (when using Pingora/Rust gateway)
# When enabled, authentication is delegated to the gateway
# and X-User-ID header is trusted from gateway requests
API_GATEWAY_ENABLED=false

# Header name for user ID from gateway (default: X-User-ID)
API_GATEWAY_USER_ID_HEADER=X-User-ID

# Trusted gateway IP addresses (comma-separated)
# Only requests from these IPs will have X-User-ID header trusted
# Examples:
#   127.0.0.1           - localhost (for development)
#   10.0.0.0/8          - Private network range
#   172.16.0.0/12       - Docker default network
#   192.168.0.0/16      - Local network
# Production: Set to your gateway's internal IP address
API_GATEWAY_TRUSTED_IPS=127.0.0.1

# ============================================================================
# SESSION CONFIGURATION
# ============================================================================

# Session cookie name
SESSION_COOKIE_NAME=neos_session

# Session expiration (seconds, default: 604800 = 7 days)
SESSION_EXPIRE_SECONDS=604800

# ============================================================================
# RATE LIMITING
# ============================================================================

# Login/Register rate limits
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900

# API calls per minute
RATE_LIMIT_API_CALLS_PER_MINUTE=100

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Allowed origins (comma-separated for multiple)
# Production: https://yourdomain.com
# Development: http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Allow credentials
CORS_ALLOW_CREDENTIALS=true

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# API version prefix
API_V1_PREFIX=/api/v1

# Debug mode (NEVER enable in production!)
DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Environment: development, staging, production
ENVIRONMENT=production

# ============================================================================
# OBSERVABILITY CONFIGURATION
# ============================================================================

# Enable observability features
OBSERVABILITY_ENABLED=true

# Phoenix configuration
PHOENIX_HOST=localhost
PHOENIX_PORT=6006
PHOENIX_PROJECT_NAME=neos-multi-agent

# Enable metrics collection
METRICS_ENABLED=true

# Enable distributed tracing
TRACE_ENABLED=true

# Maximum traces to keep
MAX_TRACES=1000

# Trace retention (days)
TRACE_RETENTION_DAYS=30

# Track LLM calls, agents, and workflows
TRACK_LLM_CALLS=true
TRACK_AGENT_PERFORMANCE=true
TRACK_WORKFLOW_METRICS=true

# ============================================================================
# MCP (MODEL CONTEXT PROTOCOL) CONFIGURATION
# ============================================================================

# Enable MCP
MCP_ENABLED=true

# MCP server configuration
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8000
MCP_TIMEOUT=30
MCP_RETRY_COUNT=3
MCP_FALLBACK_ENABLED=true

# Tool selection strategy: always, mcp_available, mcp_fallback, preference_based
TOOL_SELECTION_STRATEGY=mcp_fallback

# Tool quality threshold (0.0-1.0)
TOOL_QUALITY_THRESHOLD=0.7

# Performance priority
TOOL_PERFORMANCE_PRIORITY=false

# ============================================================================
# DATASET COLLECTION
# ============================================================================

# Auto-save datasets after workflow execution
DATASET_AUTO_SAVE=true

# Dataset format: jsonl, json, csv
DATASET_SAVE_FORMAT=jsonl

# Dataset storage path
DATASET_BASE_PATH=datasets

# ============================================================================
# WEB SEARCH LOGGING
# ============================================================================

# Async logging for web searches
WEB_SEARCH_LOG_ASYNC=true

# Log queue type: memory, redis, kafka
WEB_SEARCH_LOG_QUEUE_TYPE=memory

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================

# Storage provider: s3, rustfs, local
STORAGE_PROVIDER=local

# Local storage path
LOCAL_STORAGE_PATH=storage/documents

# S3 Configuration (if using S3)
S3_BUCKET_NAME=neos-documents
S3_ENDPOINT_URL=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# RustFS Configuration (if using rustfs)
RUSTFS_BUCKET_NAME=neos-documents
RUSTFS_ENDPOINT_URL=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# ============================================================================
# DOCUMENT PROCESSING
# ============================================================================

# Maximum file size (bytes, default: 52428800 = 50MB)
MAX_FILE_SIZE=52428800

# Chunk size for document processing
CHUNK_SIZE=1000

# Chunk overlap
CHUNK_OVERLAP=200

# ============================================================================
# KNOWLEDGE GRAPH EXTRACTION
# ============================================================================

# Enable knowledge graph extraction
KG_EXTRACTION_ENABLED=true

# Model for KG extraction
KG_EXTRACTION_MODEL=gpt-4-turbo-preview

# Minimum confidence threshold
KG_MIN_CONFIDENCE=0.7

# ============================================================================
# DEEP RESEARCH CONFIGURATION
# ============================================================================

# Maximum polling duration (seconds, default: 1800 = 30 minutes)
DEEP_RESEARCH_MAX_POLLING_DURATION=1800

# Poll interval (seconds)
DEEP_RESEARCH_POLL_INTERVAL=2

# Default quality score
DEEP_RESEARCH_DEFAULT_QUALITY_SCORE=0.85

# Chunk size for processing
DEEP_RESEARCH_CHUNK_SIZE=200

# Maximum sources in memory
DEEP_RESEARCH_MAX_SOURCES_IN_MEMORY=50

# Maximum concurrent requests
DEEP_RESEARCH_MAX_CONCURRENT_REQUESTS=3

# Minimum request interval (seconds)
DEEP_RESEARCH_MIN_REQUEST_INTERVAL=0.5

# ============================================================================
# MESSAGE QUEUE (RABBITMQ/CELERY)
# ============================================================================

# RabbitMQ password
RABBITMQ_PASSWORD=CHANGE_THIS_RABBITMQ_PASSWORD

# Celery broker URL
CELERY_BROKER_URL=amqp://neos:CHANGE_THIS_RABBITMQ_PASSWORD@localhost:5672/neos

# Celery result backend
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================================================
# MONITORING (PROMETHEUS/GRAFANA)
# ============================================================================

# Grafana admin password
GRAFANA_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD

# ============================================================================
# PRODUCTION DEPLOYMENT NOTES
# ============================================================================

# 1. Generate secure secrets:
#    - JWT_SECRET_KEY: openssl rand -hex 32
#    - Passwords: openssl rand -base64 32
#
# 2. Change ALL passwords and keys marked with "CHANGE_THIS"
#
# 3. Set DEBUG=false in production
#
# 4. Use strong DATABASE_URL password
#
# 5. Configure SSL/TLS in reverse proxy (Nginx)
#
# 6. Enable firewall rules (UFW, iptables, or cloud security groups)
#
# 7. Set up automated backups for PostgreSQL and Redis
#
# 8. Configure monitoring alerts (Prometheus Alertmanager)
#
# 9. Review and restrict CORS_ALLOWED_ORIGINS
#
# 10. Consider using HashiCorp Vault or AWS Secrets Manager for secrets
