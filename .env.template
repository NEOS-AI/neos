# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost/ai_system
DATABASE_POOL_SIZE=10

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# Cache Configuration
WORKFLOW_RESPONSE_CACHE_TTL=86400

# AI Service API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Weather API Configuration
# Get your API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Currency Exchange API Configuration
# Get your API key from: https://www.exchangerate-api.com/
EXCHANGERATE_API_KEY=your_exchangerate_api_key_here

# Stock Market API Configuration
# Choose provider: "yahoo" (free, no key needed) or "financialdatasets" (requires API key)
STOCK_API_PROVIDER=yahoo

# FinancialDatasets.ai API Key (optional, only if STOCK_API_PROVIDER=financialdatasets)
# Get your API key from: https://financialdatasets.ai/
FINANCIALDATASETS_API_KEY=your_financialdatasets_api_key_here

# Alpha Vantage API Key (optional, backup for financial statements)
# Get your API key from: https://www.alphavantage.co/
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# LLM Configuration
LLM_PROVIDER=anthropic
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.1

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Vision Model Configuration
VISION_PROVIDER=auto
VISION_ENABLED=True
VISION_MAX_TOKENS=1000
VISION_IMAGE_DETAIL=auto

# Agent Configuration
MAX_ITERATIONS=10
AGENT_TIMEOUT=300

# API Configuration
DEBUG=False

# Logging Configuration
LOG_LEVEL=INFO

# Observability Configuration
OBSERVABILITY_ENABLED=True
PHOENIX_HOST=localhost
PHOENIX_PORT=6006

# Metrics Configuration
METRICS_ENABLED=True
TRACE_ENABLED=True
MAX_TRACES=1000
TRACE_RETENTION_DAYS=30

# MCP Configuration
MCP_ENABLED=True
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8000
MCP_TIMEOUT=30
MCP_RETRY_COUNT=3
MCP_FALLBACK_ENABLED=True

# Tool Selection Configuration
TOOL_SELECTION_STRATEGY=mcp_fallback
TOOL_QUALITY_THRESHOLD=0.7
TOOL_PERFORMANCE_PRIORITY=False

# Dataset Configuration
DATASET_AUTO_SAVE=True
DATASET_SAVE_FORMAT=jsonl
DATASET_BASE_PATH=datasets

# Web Search Configuration
WEB_SEARCH_LOG_ASYNC=True
WEB_SEARCH_LOG_QUEUE_TYPE=memory

# ============================================================================
# Document Management Configuration
# ============================================================================

# Storage Provider: s3, rustfs, local
STORAGE_PROVIDER=local

# S3 Configuration (for AWS S3)
S3_BUCKET_NAME=neos-documents
S3_ENDPOINT_URL=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# rustfs Configuration (S3-compatible storage)
RUSTFS_BUCKET_NAME=neos-documents
RUSTFS_ENDPOINT_URL=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# Local Storage Configuration
LOCAL_STORAGE_PATH=storage/documents

# Document Processing Configuration
MAX_FILE_SIZE=52428800  # 50MB in bytes
CHUNK_SIZE=1000  # Characters per chunk
CHUNK_OVERLAP=200  # Character overlap between chunks

# Knowledge Graph Extraction Configuration
KG_EXTRACTION_ENABLED=True
KG_EXTRACTION_MODEL=gpt-4-turbo-preview
KG_MIN_CONFIDENCE=0.7
