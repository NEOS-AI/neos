# NEOS Environment Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL connection URL
# Format: postgresql+asyncpg://username:password@host:port/database
DATABASE_URL=postgresql+asyncpg://neos_user:CHANGE_THIS_PASSWORD@localhost:5432/neos_db

# Database connection pool settings
# 연결 풀 최적화: 총 50개 (20+30) 연결로 DB 부하 방지
# PostgreSQL max_connections를 확인하고 조정하세요 (기본값: 100)
DATABASE_POOL_SIZE=20  # 기본 연결 풀 크기
DATABASE_MAX_OVERFLOW=30  # 추가 가능한 최대 연결 수
DATABASE_POOL_TIMEOUT=30  # 연결 대기 타임아웃 (초)
DATABASE_POOL_RECYCLE=1800  # 연결 재사용 시간 (초, 30분)

# ============================================================================
# REDIS CACHE CONFIGURATION
# ============================================================================

# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# Default cache TTL in seconds (default: 3600 = 1 hour)
REDIS_TTL=3600

# Redis connection pool settings (신규 추가)
REDIS_POOL_SIZE=50  # 최대 연결 수
REDIS_MIN_IDLE_CONNECTIONS=10  # 최소 유휴 연결 수

# Workflow response cache TTL (2시간)
WORKFLOW_RESPONSE_CACHE_TTL=7200

# User-specific cache separation (사용자별 캐시 분리)
# 개인화된 응답이 필요한 경우에만 활성화 (기본값: false)
USER_SPECIFIC_CACHE=false

# Semantic caching configuration
# 유사한 쿼리의 응답을 재사용하여 LLM 호출 비용과 응답 시간을 절감
SEMANTIC_CACHE_ENABLED=true  # 개선: 기본값 활성화
SEMANTIC_CACHE_THRESHOLD=0.90  # 개선: 유사도 임계값 낮춤 (0.95 → 0.90, 더 많은 캐시 히트)

# ============================================================================
# AI SERVICE API KEYS (REQUIRED)
# ============================================================================

# OpenAI API Key (required for embeddings and GPT models)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_API_KEY

# Anthropic API Key (required for Claude models)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_ANTHROPIC_API_KEY
# The coding model reuses ANTHROPIC_API_KEY; configure its non-secret policy in YAML.

# Tavily Search API Key (required for web search)
# Get from: https://tavily.com/
TAVILY_API_KEY=tvly-REPLACE_WITH_YOUR_TAVILY_API_KEY

# Semantic Scholar API Key (optional, free API works without key)
# Get from: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# NewsAPI Key (required for news_api skill)
# Get from: https://newsapi.org/
NEWS_API_KEY=

# YouTube Data API v3 Key (optional, for video search)
# Get from: https://console.cloud.google.com/apis/credentials
# Note: Transcript fetching works without API key
YOUTUBE_API_KEY=

# ============================================================================
# YOUTUBE INTEGRATION CONFIGURATION
# ============================================================================

# Maximum number of video search results
YOUTUBE_MAX_RESULTS=10

# Preferred transcript languages (comma-separated)
# Auto-detect will try all available languages in order
YOUTUBE_TRANSCRIPT_LANGUAGES=en,ko

# Minimum relevance score for video recommendations (0.0-1.0)
YOUTUBE_MIN_RELEVANCE_SCORE=0.5

# Enable auto-generated captions as fallback
YOUTUBE_ENABLE_AUTO_CAPTIONS=true

# Maximum transcript length for analysis (characters)
YOUTUBE_MAX_TRANSCRIPT_LENGTH=50000

# ============================================================================
# PHASE 3 SEARCH SOURCE API KEYS (OPTIONAL)
# ============================================================================

# GitHub API Token (optional, increases rate limits from 10 to 30 req/min)
# Get from: https://github.com/settings/tokens
GITHUB_API_TOKEN=

# Reddit API (required for Reddit skill)
# Get from: https://www.reddit.com/prefs/apps/
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=NEOS-Research-Engine/1.0

# SerpAPI (required for Google Scholar skill)
# Get from: https://serpapi.com/
SERPAPI_API_KEY=

# SEC EDGAR (no key needed, just a User-Agent with contact info)
SEC_EDGAR_USER_AGENT=NEOS-Research contact@neos.ai

# OpenAlex (no key needed, email for polite pool - faster responses)
OPENALEX_EMAIL=

# ============================================================================
# EXTERNAL API KEYS (OPTIONAL)
# ============================================================================

# Weather API (OpenWeatherMap)
# Get from: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Currency Exchange API
# Get from: https://www.exchangerate-api.com/
EXCHANGERATE_API_KEY=

# Stock Market APIs
STOCK_API_PROVIDER=yahoo
FINANCIALDATASETS_API_KEY=
ALPHA_VANTAGE_API_KEY=

# ============================================================================
# LLM CONFIGURATION
# ============================================================================

# LLM Provider: "openai" or "anthropic"
LLM_PROVIDER=anthropic

# LLM Model name
# OpenAI: gpt-4-turbo-preview, gpt-4, gpt-3.5-turbo
# Anthropic: claude-opus-4-5-20251101, claude-sonnet-4-5-20250929, claude-haiku-4-5-20251001
LLM_MODEL=claude-sonnet-4-5-20250929

# LLM Temperature (0.0 = deterministic, 2.0 = creative)
LLM_TEMPERATURE=0.7

LLM_TIMEOUT=180
LLM_TIMEOUT_RESEARCH_PLANNING=300

# ============================================================================
# EMBEDDING CONFIGURATION
# ============================================================================

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small

# Embedding dimension (must match model)
# text-embedding-3-small: 1536
# text-embedding-3-large: 3072
EMBEDDING_DIMENSION=1536

# ============================================================================
# VISION MODEL CONFIGURATION
# ============================================================================

# Vision provider: "gpt4o", "claude", "auto"
VISION_PROVIDER=auto

# Enable/disable vision features
VISION_ENABLED=true

# Vision model max tokens
VISION_MAX_TOKENS=1000

# GPT-4o image detail level: "auto", "low", "high"
VISION_IMAGE_DETAIL=auto

# ============================================================================
# AGENT CONFIGURATION
# ============================================================================

# Maximum agent iterations
MAX_ITERATIONS=10

# Agent timeout in seconds
AGENT_TIMEOUT=300

# Agent concurrency settings (신규 추가)
MAX_CONCURRENT_WORKFLOWS=100  # 최대 동시 워크플로우 수
MAX_CONCURRENT_AGENTS_PER_WORKFLOW=10  # 워크플로우당 최대 동시 에이전트 수

# Streaming configuration (스트리밍 설정)
STREAM_EVENT_TIMEOUT=2.0  # SSE 이벤트 큐 대기 타임아웃 (초)
STREAM_HEARTBEAT_INTERVAL=30  # SSE heartbeat 전송 간격 (초)

# Circuit Breaker Configuration (신규 추가 - 고성능 멀티 에이전트 시스템)
CIRCUIT_BREAKER_ENABLED=true  # Circuit Breaker 활성화
CIRCUIT_BREAKER_FAIL_THRESHOLD=5  # 연속 실패 횟수 (이 횟수만큼 실패하면 차단)
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60  # 복구 시도 간격 (초)

# ============================================================================
# AUTHENTICATION & SECURITY (CRITICAL - MUST CHANGE IN PRODUCTION!)
# ============================================================================

# JWT Secret Key - **REQUIRED** - Application will not start without this!
# Generate a secure key with one of these commands:
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Example output: 7f8a9b2c5d1e4f6a8b3c9d2e1f4a6b8c9d2e1f4a6b8c9d2e1f4a6b8c9d2e
JWT_SECRET_KEY=

# JWT algorithm
JWT_ALGORITHM=HS256

# Access token expiration (minutes)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token expiration (days)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# GOOGLE OAUTH CONFIGURATION
# ============================================================================

# Google OAuth Client ID (for backend token verification)
# Get from: https://console.cloud.google.com/apis/credentials
# This should match the GOOGLE_CLIENT_ID in your frontend .env
# Used by the backend to verify Google ID tokens
GOOGLE_OAUTH_CLIENT_ID=

# Note: GOOGLE_CLIENT_SECRET is NOT required for backend
# The backend only verifies ID tokens using the Client ID

# ============================================================================
# API GATEWAY CONFIGURATION
# ============================================================================

# Enable API Gateway mode (when using Pingora/Rust gateway)
# When enabled, authentication is delegated to the gateway
# and X-User-ID header is trusted from gateway requests
API_GATEWAY_ENABLED=false

# Header name for user ID from gateway (default: X-User-ID)
API_GATEWAY_USER_ID_HEADER=X-User-ID

# Trusted gateway IP addresses (comma-separated)
# Only requests from these IPs will have X-User-ID header trusted
# Examples:
#   127.0.0.1           - localhost (for development)
#   10.0.0.0/8          - Private network range
#   172.16.0.0/12       - Docker default network
#   192.168.0.0/16      - Local network
# Production: Set to your gateway's internal IP address
API_GATEWAY_TRUSTED_IPS=127.0.0.1

# ============================================================================
# SESSION CONFIGURATION
# ============================================================================

# Session cookie name
SESSION_COOKIE_NAME=neos_session

# Session expiration (seconds, default: 604800 = 7 days)
SESSION_EXPIRE_SECONDS=604800

# ============================================================================
# RATE LIMITING
# ============================================================================

# Login/Register rate limits
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900

# API calls per minute
RATE_LIMIT_API_CALLS_PER_MINUTE=100

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Allowed origins (comma-separated for multiple)
# Production: https://yourdomain.com
# Development: http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Allow credentials
CORS_ALLOW_CREDENTIALS=true

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# API version prefix
API_V1_PREFIX=/api/v1

# Debug mode (NEVER enable in production!)
DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Environment: development, staging, production
ENVIRONMENT=production

# Artifacts settings
ARTIFACTS_ENABLED=true
ARTIFACT_LLM_MAX_TOKENS=4096
ARTIFACT_LLM_TEMPERATURE=0.7
ARTIFACT_LLM_MODEL=claude-haiku-4-5-20251001

# ============================================================================
