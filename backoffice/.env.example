# Analytics Backoffice Environment Variables

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/neos

# Redis
REDIS_URL=redis://localhost:6379/1

# Celery
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# LLM Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL=claude-3-sonnet-20240229
EMBEDDING_MODEL=all-mpnet-base-v2

# Application
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-change-in-production

# Clustering Configuration
MIN_CLUSTER_SIZE=10
MIN_SAMPLES=5
UMAP_N_NEIGHBORS=15
UMAP_MIN_DIST=0.1

# Privacy Configuration
PRIVACY_MIN_USERS_PER_CLUSTER=1000
PRIVACY_MIN_CONVERSATIONS_PER_CLUSTER=100
PII_DETECTION_ENABLED=true

# Pipeline
BATCH_SIZE=100
MAX_CONVERSATIONS_PER_RUN=10000
